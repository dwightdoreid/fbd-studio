{
  "version": 1,
  "id": "20261117-141114-ex77tq",
  "name": "20 State feedback - motor position",
  "description": "LQR state feedback positions a simulated DC motor: speed is a first-order lag of the voltage (PT1, 0.5 s), position is the integral of speed (INTEG). STATE_FB computes u = KR*R - K1*position - K2*speed with LQR gains.",
  "board": "esp32dev",
  "settings": {
    "cycle_ms": 5,
    "monitor_ms": 200,
    "baud": 115200
  },
  "blocks": [
    {
      "id": "b1",
      "type": "STATE_FB",
      "name": "Lqr",
      "x": 80.0,
      "y": 60.0,
      "values": {
        "R": "1.0",
        "K1": "10.0",
        "K2": "2.317",
        "KR": "10.0",
        "OUT_MIN": "-12.0",
        "OUT_MAX": "12.0"
      },
      "params": {},
      "type_args": {},
      "counts": {},
      "comment": "R = target position (rad)"
    },
    {
      "id": "b2",
      "type": "PT1",
      "name": "MotorSpeed",
      "x": 330.0,
      "y": 60.0,
      "values": {
        "K": "1.0",
        "T": "T#500ms"
      },
      "params": {
        "start_at_input": false
      },
      "type_args": {},
      "counts": {},
      "comment": "rad/s per volt"
    },
    {
      "id": "b3",
      "type": "INTEG",
      "name": "MotorAngle",
      "x": 580.0,
      "y": 60.0,
      "values": {},
      "params": {},
      "type_args": {},
      "counts": {},
      "comment": "rad"
    },
    {
      "id": "b4",
      "type": "PWM",
      "name": "VoltageLED",
      "x": 580.0,
      "y": 300.0,
      "values": {},
