      "id": "b1",
      "type": "WIFI",
      "name": "WiFi",
      "x": 80.0,
      "y": 60.0,
      "values": {},
      "params": {
        "ssid": "MyWiFi",
        "password": "change-me",
        "hostname": "fbd-plc1"
      },
      "type_args": {},
      "counts": {},
      "comment": "enter your network here"
    },
    {
      "id": "b2",
      "type": "MQTT_CLIENT",
      "name": "Broker",
      "x": 80.0,
      "y": 182.0,
